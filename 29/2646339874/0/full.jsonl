            "output": "<path>/home/himmel/dev/environment/home/scripts/open-repos</path>\n<type>file</type>\n<content>\n1: #!/usr/bin/env bash\n2: \n3: # Inside a tmux popup TMUX is set but TMUX_PANE is not. There, display-message\n4: # resolves to the active pane behind the popup (wrong cwd), and fzf --height\n5: # conflicts with the popup's screen handling (blank/frozen popup).\n6: in_tmux_popup() {\n7:     [[ -n \"${TMUX:-}\" && -z \"${TMUX_PANE:-}\" ]]\n8: }\n9: \n10: if [[ -n \"${TMUX:-}\" ]] && ! in_tmux_popup; then\n11:     repo_dir=$(tmux display-message -p -F '#{pane_current_path}')\n12:     cd \"$repo_dir\" || exit 1\n13: fi\n14: \n15: if in_tmux_popup; then\n16:     fz() { fzf --prompt=\"$1\" --reverse; }\n17: else\n18:     fz() { fzf --prompt=\"$1\" --height=40% --reverse; }\n19: fi\n20: \n21: remotes=$(git remote -v | grep '(fetch)' | awk '{print $1 \" -> \" $2}')\n22: \n23: if [[ -z \"$remotes\" ]]; then\n24:     echo \"No git remotes found\"\n25:     exit 1\n26: fi\n27: \n28: remote_count=$(echo \"$remotes\" | wc -l)\n29: \n30: if [[ $remote_count -eq 1 ]]; then\n31:     selected=\"$remotes\"\n32: else\n33:     selected=$(echo \"$remotes\" | fz \"Select remote: \")\n34:     # Exit if nothing was selected\n35:     if [[ -z \"$selected\" ]]; then\n36:         exit 0\n37:     fi\n38: fi\n39: \n40: remote_url=$(echo \"$selected\" | awk '{print $3}')\n41: \n42: # Turn common Git remote formats into an owner/repository path. This lets the\n43: # same local repository be opened in any of the supported web frontends.\n44: if [[ \"$remote_url\" == git@*:* ]]; then\n45:     repo_path=\"${remote_url#*:}\"\n46: else\n47:     repo_path=\"${remote_url#*://}\"\n48:     repo_path=\"${repo_path#*/}\"\n49: fi\n50: repo_path=\"${repo_path%.git}\"\n51: repo_path=\"$(printf '%s' \"$repo_path\" | tr '[:upper:]' '[:lower:]')\"\n52: \n53: if [[ -z \"$repo_path\" || \"$repo_path\" == \"$remote_url\" && \"$remote_url\" != git@*:* ]]; then\n54:     echo \"Could not determine repository path from remote: $remote_url\"\n55:     exit 1\n56: fi\n57: \n58: destination=$(printf '%s\\n' \\\n59:     \"GitHub\" \\\n60:     \"Better Hub\" \\\n61:     \"OpenGit\" \\\n62:     \"Codeberg\" \\\n63:     \"Gitea\" \\\n64:     \"Entire\" \\\n65:     \"Trylle\" \\\n66:     \"GitCafe\" \\\n67:     \"GitLab\" |\n68:     fz \"Open in: \")\n69: \n70: if [[ -z \"$destination\" ]]; then\n71:     exit 0\n72: fi\n73: \n74: case \"$destination\" in\n75:     \"GitHub\")\n76:         url=\"https://github.com/$repo_path\"\n77:         ;;\n78:     \"Better Hub\")\n79:         url=\"https://beta.better-hub.com/$repo_path\"\n80:         ;;\n81:     \"OpenGit\")\n82:         url=\"https://open-git.com/$repo_path\"\n83:         ;;\n84:     \"Codeberg\")\n85:         url=\"https://codeberg.org/$repo_path\"\n86:         ;;\n87:     \"Gitea\")\n88:         url=\"https://gitea.com/$repo_path\"\n89:         ;;\n90:     \"Entire\")\n91:         url=\"https://entire.io/gh/$repo_path\"\n92:         ;;\n93:     \"Trylle\")\n94:         url=\"https://trylle.com/$repo_path\"\n95:         ;;\n96:     \"GitCafe\")\n97:         url=\"https://git.cafe/$repo_path\"\n98:         ;;\n99:     \"GitLab\")\n100:         url=\"https://gitlab.com/$repo_path\"\n101:         ;;\n102: esac\n103: \n104: # fzf/tmux can preserve an accidental space in a copied remote URL. A web URL\n105: # must not contain whitespace, so normalize it before handing it to the opener.\n106: url=\"${url//[[:space:]]/}\"\n107: printf 'Opening: %s\\n' \"$url\"\n108: \n109: # Launch synchronously where possible: when run from a tmux popup, the popup\n110: # (and its process group) is torn down as soon as this script exits, which\n111: # kills a backgrounded launcher before it can hand off. systemd-run returns\n112: # immediately after registering the unit, and setsid --fork detaches the\n113: # fallback openers into their own session so they survive popup teardown.\n114: browser_desktop=$(env -u BROWSER xdg-settings get default-web-browser 2>/dev/null)\n115: if [[ \"$browser_desktop\" == \"app.zen_browser.zen.desktop\" ]] && command -v uwsm-app >/dev/null 2>&1; then\n116:     systemd-run --user --quiet --collect \\\n117:         --unit=\"open-repo-browser-$(date +%s%N)\" \\\n118:         uwsm-app -- flatpak run app.zen_browser.zen \"$url\" \\\n119:         >/dev/null 2>&1 </dev/null\n120: elif command -v omarchy-launch-browser >/dev/null 2>&1; then\n121:     setsid --fork omarchy-launch-browser \"$url\" >/dev/null 2>&1 </dev/null\n122: elif command -v gio >/dev/null 2>&1; then\n123:     setsid --fork gio open \"$url\" >/dev/null 2>&1 </dev/null\n124: else\n125:     setsid --fork xdg-open \"$url\" >/dev/null 2>&1 </dev/null\n126: fi\n\n(End of file - total 126 lines)\n</content>",
