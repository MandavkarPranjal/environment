            "output": "<path>/home/himmel/dev/environment/home/.config/hypr/bindings.lua</path>\n<type>file</type>\n<content>\n1: -- Personal keybindings.\n2: -- Ported from the pre-quattro bindings.conf and bindings-override.conf.\n3: --\n4: -- The SUPER -> ALT swap of Omarchy's defaults happens in hyprland.lua; the\n5: -- entries below are the bindings the defaults don't already provide, plus the\n6: -- handful the old override handled specially (TAB/PRINT/monitor groups) that\n7: -- need explicit unbinds because the swapped defaults would collide.\n8: \n9: -- ---------------------------------------------------------------- Applications\n10: hl.unbind(\"ALT + RETURN\")\n11: o.bind(\"ALT + RETURN\", \"Terminal\", [[uwsm-app -- xdg-terminal-exec --dir=\"$(omarchy-cmd-terminal-cwd)\"]])\n12: \n13: hl.unbind(\"SUPER + ALT + RETURN\")\n14: o.bind(\n15: \t\"SUPER + ALT + RETURN\",\n16: \t\"Tmux\",\n17: \t[[uwsm-app -- xdg-terminal-exec --dir=\"$(omarchy-cmd-terminal-cwd)\" bash -c \"tmux attach || tmux new -s Work\"]]\n18: )\n19: \n20: hl.unbind(\"ALT + SHIFT + RETURN\")\n21: o.bind(\"ALT + SHIFT + RETURN\", \"Browser\", \"omarchy-launch-browser\")\n22: \n23: hl.unbind(\"ALT + SHIFT + F\")\n24: o.bind(\"ALT + SHIFT + F\", \"File manager\", \"uwsm-app -- nautilus --new-window\")\n25: \n26: hl.unbind(\"SUPER + ALT + SHIFT + F\")\n27: o.bind(\n28: \t\"SUPER + ALT + SHIFT + F\",\n29: \t\"File manager (cwd)\",\n30: \t[[uwsm-app -- nautilus --new-window \"$(omarchy-cmd-terminal-cwd)\"]]\n31: )\n32: \n33: hl.unbind(\"ALT + SHIFT + B\")\n34: o.bind(\"ALT + SHIFT + B\", \"Browser\", \"omarchy-launch-browser\")\n35: \n36: hl.unbind(\"SUPER + SHIFT + ALT + B\")\n37: o.bind(\"SUPER + SHIFT + ALT + B\", \"Browser (private)\", \"omarchy-launch-browser --private\")\n38: \n39: -- ------------------------------------------------------------------------ OCR\n40: hl.unbind(\"ALT + CTRL + PRINT\")\n41: o.bind(\"ALT + SHIFT + O\", \"Extract text (OCR) from screenshot\", \"omarchy-capture-text\")\n42: \n43: -- -------------------------------------------------------------- Screenshot trio\n44: -- The old override flipped screenrecording and the color picker, and moved\n45: -- OCR away from the Print key entirely.\n46: hl.unbind(\"ALT + PRINT\")\n47: hl.unbind(\"SUPER + PRINT\")\n48: o.bind(\n49: \t\"SUPER + PRINT\",\n50: \t\"Screenrecording\",\n51: \t[[omarchy-capture-screenrecording --stop-recording || omarchy-menu toggle trigger.capture.screenrecord]]\n52: )\n53: o.bind(\"ALT + PRINT\", \"Color picker\", \"pkill hyprpicker || hyprpicker -a\")\n54: \n55: -- -------------------------------------------------------------- Hold + scroll\n56: -- SUPER + scroll zooms (workspace scrolling is the swapped ALT + scroll).\n57: hl.unbind(\"SUPER + mouse_down\")\n58: hl.unbind(\"SUPER + mouse_up\")\n59: hl.unbind(\"SUPER + SHIFT + mouse_down\")\n60: o.bind(\"SUPER + mouse_down\", \"Zoom in\", function()\n61: \tlocal zoom = hl.get_config(\"cursor.zoom_factor\") or 1\n62: \thl.config({ cursor = { zoom_factor = math.min(zoom * 1.5, 30) } })\n63: end)\n64: o.bind(\"SUPER + mouse_up\", \"Zoom out\", function()\n65: \tlocal zoom = hl.get_config(\"cursor.zoom_factor\") or 1\n66: \thl.config({ cursor = { zoom_factor = math.max(zoom * 0.67, 1) } })\n67: end)\n68: o.bind(\"SUPER + SHIFT + mouse_down\", \"Reset zoom\", function()\n69: \thl.config({ cursor = { zoom_factor = 1 } })\n70: end)\n71: \n72: -- ------------------------------------------------------------- Wayscriber\n73: o.bind(\"SUPER + D\", \"Wayscriber\", \"wayscriber --daemon-toggle\")\n74: \n75: -- ----------------------------------------------------------------- Launchers\n76: -- ALT + SPACE opens the app launcher (old omarchy-launch-walker / launch-app);\n77: -- SUPER + SPACE and SUPER + ALT + SPACE open the Omarchy root menu.\n78: hl.unbind(\"ALT + SPACE\")\n79: o.bind(\"ALT + SPACE\", \"Launch apps\", \"omarchy-menu toggle apps\")\n80: hl.unbind(\"SUPER + SPACE\")\n81: o.bind(\"SUPER + SPACE\", \"Omarchy menu\", \"omarchy-menu toggle root\")\n82: hl.unbind(\"SUPER + ALT + SPACE\")\n83: o.bind(\"SUPER + ALT + SPACE\", \"Omarchy menu\", \"omarchy-menu toggle root\")\n84: \n85: -- ------------------------------------------------------ TAB / monitor groups\n86: -- The old override moved window cycling from ALT + TAB to SUPER + TAB so that\n87: -- ALT + TAB could switch workspaces.\n88: hl.unbind(\"ALT + TAB\")\n89: hl.unbind(\"ALT + SHIFT + TAB\")\n90: o.bind(\"ALT + TAB\", \"Next workspace\", hl.dsp.focus({ workspace = \"e+1\" }))\n91: o.bind(\"ALT + SHIFT + TAB\", \"Previous workspace\", hl.dsp.focus({ workspace = \"e-1\" }))\n92: o.bind(\"SUPER + TAB\", \"Focus on next window\", hl.dsp.window.cycle_next())\n93: o.bind(\"SUPER + TAB\", \"Reveal active window on top\", hl.dsp.window.bring_to_top())\n94: o.bind(\"SUPER + SHIFT + TAB\", \"Focus on previous window\", hl.dsp.window.cycle_next({ next = false }))\n95: o.bind(\"SUPER + SHIFT + TAB\", \"Reveal active window on top\", hl.dsp.window.bring_to_top())\n96: \n97: hl.unbind(\"CTRL + ALT + TAB\")\n98: o.bind(\"CTRL + SUPER + TAB\", \"Focus on next monitor\", hl.dsp.focus({ monitor = \"+1\" }))\n99: hl.unbind(\"CTRL + ALT + SHIFT + TAB\")\n100: o.bind(\"CTRL + SUPER + SHIFT + TAB\", \"Focus on previous monitor\", hl.dsp.focus({ monitor = \"-1\" }))\n101: \n102: -- ---------------------------------------------------------------- Close all\n103: hl.unbind(\"CTRL + ALT + DELETE\")\n104: o.bind(\"CTRL + SUPER + DELETE\", \"Close all windows\", \"omarchy-hyprland-window-close-all\")\n105: \n106: -- -------------------------------------------------------- Audio / brightness\n107: -- Precise controls move from ALT (the new main modifier) to SUPER.\n108: hl.unbind(\"ALT + XF86AudioRaiseVolume\")\n109: o.bind(\n110: \t\"SUPER + XF86AudioRaiseVolume\",\n111: \t\"Volume up precise\",\n112: \t\"omarchy-audio-output-volume +1\",\n113: \t{ locked = true, repeating = true }\n114: )\n115: hl.unbind(\"ALT + XF86AudioLowerVolume\")\n116: o.bind(\n117: \t\"SUPER + XF86AudioLowerVolume\",\n118: \t\"Volume down precise\",\n119: \t\"omarchy-audio-output-volume -1\",\n120: \t{ locked = true, repeating = true }\n121: )\n122: hl.unbind(\"ALT + XF86MonBrightnessUp\")\n123: o.bind(\n124: \t\"SUPER + XF86MonBrightnessUp\",\n125: \t\"Brightness up precise\",\n126: \t\"omarchy-brightness-display +1%\",\n127: \t{ locked = true, repeating = true }\n128: )\n129: hl.unbind(\"ALT + XF86MonBrightnessDown\")\n130: o.bind(\n131: \t\"SUPER + XF86MonBrightnessDown\",\n132: \t\"Brightness down precise\",\n133: \t\"omarchy-brightness-display 1%-\",\n134: \t{ locked = true, repeating = true }\n135: )\n136: \n137: -- Switch audio output on ALT + Mute.\n138: o.bind(\"ALT + XF86AudioMute\", \"Switch audio output\", \"omarchy-audio-output-switch\", { locked = true })\n\n(End of file - total 138 lines)\n</content>",
            "metadata": {
