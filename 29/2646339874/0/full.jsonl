            {
              "file": "home/scripts/tmux-sessionizer",
              "patch": "Index: home/scripts/tmux-sessionizer\n===================================================================\n--- home/scripts/tmux-sessionizer\t\n+++ home/scripts/tmux-sessionizer\t\n@@ -1,65 +1,100 @@\n #!/usr/bin/env bash\n+set -euo pipefail\n \n+# Pick a project with fzf, create a tmux session for it if needed\n+# (windows: nvim / shell / opencode), then attach or switch to it.\n+#\n+# Works from inside tmux, from inside a tmux display-popup (where TMUX is\n+# set but TMUX_PANE is not), and from a plain shell with no tmux server.\n+\n switch_to() {\n-    if [[ -z $TMUX ]]; then\n-        tmux attach-session -t $1\n+    if [[ -z \"${TMUX:-}\" ]]; then\n+        exec tmux attach-session -t \"$1\"\n     else\n-        tmux switch-client -t $1\n+        tmux switch-client -t \"$1\"\n     fi\n }\n \n has_session() {\n-    tmux list-sessions | grep -q \"^$1:\"\n+    tmux has-session -t \"$1\" 2>/dev/null\n }\n \n+# Run a project-specific (or $HOME fallback) .tmux-sessionizer in the\n+# session's shell window. It is sourced as shell, so it can use tmux\n+# commands or plain setup steps; it never gets typed into the nvim pane.\n hydrate() {\n-    if [ -f $2/.tmux-sessionizer ]; then\n-        tmux send-keys -t $1 \"source $2/.tmux-sessionizer\" c-M\n-    elif [ -f $HOME/.tmux-sessionizer ]; then\n-        tmux send-keys -t $1 \"source $HOME/.tmux-sessionizer\" c-M\n+    local session_name=\"$1\"\n+    local project_path=\"$2\"\n+    local hook=\"\"\n+\n+    if [[ -f \"$project_path/.tmux-sessionizer\" ]]; then\n+        hook=\"$project_path/.tmux-sessionizer\"\n+    elif [[ -f \"$HOME/.tmux-sessionizer\" ]]; then\n+        hook=\"$HOME/.tmux-sessionizer\"\n+    else\n+        return 0\n     fi\n+\n+    tmux send-keys -t \"$session_name:shell\" \"source $(printf '%q' \"$hook\")\" Enter\n }\n \n+# Depth-1 project roots. Kept in sync with ./sessionizer-setup. Each root\n+# contributes distinct candidates, so all are kept; missing ones are\n+# skipped and exact duplicates are removed with sort -u.\n+project_roots=(\n+    \"$HOME/projects\"\n+    \"$HOME\"\n+    \"$HOME/work\"\n+    \"$HOME/dev\"\n+    \"$HOME/dev/environment\"\n+    \"$HOME/personal\"\n+    \"$HOME/personal/yt\"\n+    \"$HOME/personal/templates\"\n+    \"$HOME/100xdev-WebDev\"\n+    \"$HOME/sandbox\"\n+)\n+\n+pick_project() {\n+    local existing=()\n+    local root\n+    for root in \"${project_roots[@]}\"; do\n+        [[ -d \"$root\" ]] && existing+=(\"$root\")\n+    done\n+    [[ ${#existing[@]} -gt 0 ]] || return 0\n+\n+    if command -v fd >/dev/null 2>&1; then\n+        fd --max-depth 1 --type d --hidden --exclude .git . \"${existing[@]}\" 2>/dev/null | sort -u\n+    else\n+        find \"${existing[@]}\" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort -u\n+    fi\n+}\n+\n if [[ $# -eq 1 ]]; then\n-    selected=$1\n+    selected=\"$1\"\n else\n-    selected=$(find ~/projects ~/ ~/work ~/dev ~/dev/environment ~/personal ~/personal/yt ~/personal/templates/ ~/100xdev-WebDev ~/sandbox -mindepth 1 -maxdepth 1 -type d | fzf)\n+    selected=\"$(pick_project | fzf || true)\"\n fi\n \n-if [[ -z $selected ]]; then\n-    exit 0\n-fi\n+[[ -n \"${selected:-}\" ]] || exit 0\n \n-selected_name=$(basename \"$selected\" | tr . _)\n-tmux_running=$(pgrep tmux)\n+# Deterministic session name. Dots and colons break tmux target parsing\n+# (session:window), so both become underscores. Everything is quoted, so\n+# spaces in paths are safe.\n+selected_name=\"$(basename \"$selected\")\"\n+selected_name=\"${selected_name//./_}\"\n+selected_name=\"${selected_name//:/_}\"\n+[[ -n \"$selected_name\" ]] || exit 0\n \n-create_session() {\n-    local session_name=$1\n-    local session_path=$2\n-    local detached=$3\n-\n-    if [[ $detached == \"true\" ]]; then\n-        tmux new-session -ds $session_name -c $session_path\n+# Atomic-ish creation: only the creator builds windows. A concurrent\n+# invocation that loses the race falls through to switch/attach.\n+if ! has_session \"$selected_name\"; then\n+    if tmux new-session -d -s \"$selected_name\" -n nvim -c \"$selected\" 'nvim'; then\n+        tmux new-window -d -t \"$selected_name\" -n shell -c \"$selected\"\n+        tmux new-window -d -t \"$selected_name\" -n opencode -c \"$selected\" 'opencode .'\n+        hydrate \"$selected_name\" \"$selected\"\n     else\n-        tmux new-session -s $session_name -c $session_path\n+        has_session \"$selected_name\" || exit 1\n     fi\n-\n-    tmux send-keys -t \"$session_name:1\" \"nvim\" c-M\n-    tmux new-window -t $session_name -c $session_path\n-    tmux new-window -t $session_name:69 -c $session_path\n-    tmux send-keys -t \"$session_name:69\" \"opencode .\" c-M\n-    tmux select-window -t \"$session_name:1\"\n-    hydrate $session_name $session_path\n-}\n-\n-if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then\n-    create_session $selected_name $selected true\n-    tmux attach-session -t $selected_name\n-    exit 0\n fi\n \n-if ! has_session $selected_name; then\n-    create_session $selected_name $selected true\n-fi\n-\n-switch_to $selected_name\n+switch_to \"$selected_name\"\n",
              "additions": 76,
              "deletions": 41,
              "status": "modified"
            }
          ]
        },
