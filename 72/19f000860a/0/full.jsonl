              "patch": "Index: home/scripts/open-repo\n===================================================================\n--- home/scripts/open-repo\t\n+++ home/scripts/open-repo\t\n@@ -1,97 +1,110 @@\n #!/usr/bin/env bash\n \n-if [[ -n \"${TMUX:-}\" ]]; then\n+# Inside a tmux popup TMUX is set but TMUX_PANE is not. There, display-message\n+# resolves to the active pane behind the popup (wrong cwd), and fzf --height\n+# conflicts with the popup's screen handling (blank/frozen popup).\n+in_tmux_popup() {\n+    [[ -n \"${TMUX:-}\" && -z \"${TMUX_PANE:-}\" ]]\n+}\n+\n+if [[ -n \"${TMUX:-}\" ]] && ! in_tmux_popup; then\n     repo_dir=$(tmux display-message -p -F '#{pane_current_path}')\n     cd \"$repo_dir\" || exit 1\n fi\n \n+if in_tmux_popup; then\n+    fz() { fzf --prompt=\"$1\" --reverse; }\n+else\n+    fz() { fzf --prompt=\"$1\" --height=40% --reverse; }\n+fi\n+\n remotes=$(git remote -v | grep '(fetch)' | awk '{print $1 \" -> \" $2}')\n \n if [[ -z \"$remotes\" ]]; then\n     echo \"No git remotes found\"\n     exit 1\n fi\n \n remote_count=$(echo \"$remotes\" | wc -l)\n \n if [[ $remote_count -eq 1 ]]; then\n     selected=\"$remotes\"\n else\n-    selected=$(echo \"$remotes\" | fzf --prompt=\"Select remote: \" --height=40% --reverse)\n+    selected=$(echo \"$remotes\" | fz \"Select remote: \")\n     # Exit if nothing was selected\n     if [[ -z \"$selected\" ]]; then\n         exit 0\n     fi\n fi\n \n remote_url=$(echo \"$selected\" | awk '{print $3}')\n \n # Turn common Git remote formats into an owner/repository path. This lets the\n # same local repository be opened in any of the supported web frontends.\n if [[ \"$remote_url\" == git@*:* ]]; then\n     repo_path=\"${remote_url#*:}\"\n else\n     repo_path=\"${remote_url#*://}\"\n     repo_path=\"${repo_path#*/}\"\n fi\n repo_path=\"${repo_path%.git}\"\n \n if [[ -z \"$repo_path\" || \"$repo_path\" == \"$remote_url\" && \"$remote_url\" != git@*:* ]]; then\n     echo \"Could not determine repository path from remote: $remote_url\"\n     exit 1\n fi\n \n destination=$(printf '%s\\n' \\\n     \"GitHub\" \\\n     \"Better Hub\" \\\n     \"OpenGit\" \\\n     \"Codeberg\" \\\n     \"Gitea\" \\\n     \"Entire\" |\n-    fzf --prompt=\"Open in: \" --height=40% --reverse)\n+    fz \"Open in: \")\n \n if [[ -z \"$destination\" ]]; then\n     exit 0\n fi\n \n case \"$destination\" in\n     \"GitHub\")\n         url=\"https://github.com/$repo_path\"\n         ;;\n     \"Better Hub\")\n         url=\"https://beta.better-hub.com/$repo_path\"\n         ;;\n     \"OpenGit\")\n         url=\"https://open-git.com/$repo_path\"\n         ;;\n     \"Codeberg\")\n         url=\"https://codeberg.org/$repo_path\"\n         ;;\n     \"Gitea\")\n         url=\"https://gitea.com/$repo_path\"\n         ;;\n     \"Entire\")\n         url=\"https://entire.io/gh/$repo_path\"\n         ;;\n esac\n \n # fzf/tmux can preserve an accidental space in a copied remote URL. A web URL\n # must not contain whitespace, so normalize it before handing it to the opener.\n url=\"${url//[[:space:]]/}\"\n printf 'Opening: %s\\n' \"$url\"\n \n # Zen is installed as a Flatpak on this Omarchy system. Launching its desktop\n # file through omarchy-launch-browser currently loses the executable path.\n browser_desktop=$(env -u BROWSER xdg-settings get default-web-browser 2>/dev/null)\n if [[ \"$browser_desktop\" == \"app.zen_browser.zen.desktop\" ]] && command -v uwsm-app >/dev/null 2>&1; then\n     nohup systemd-run --user --quiet --collect \\\n         --unit=\"open-repo-browser-$(date +%s%N)\" \\\n         uwsm-app -- flatpak run app.zen_browser.zen \"$url\" \\\n         >/dev/null 2>&1 </dev/null &\n elif command -v omarchy-launch-browser >/dev/null 2>&1; then\n     nohup omarchy-launch-browser \"$url\" >/dev/null 2>&1 </dev/null &\n elif command -v gio >/dev/null 2>&1; then\n     nohup gio open \"$url\" >/dev/null 2>&1 </dev/null &\n else\n     nohup xdg-open \"$url\" >/dev/null 2>&1 </dev/null &\n fi\n",
