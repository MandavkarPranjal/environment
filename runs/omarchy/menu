#!/usr/bin/env bash
set -uo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"
src="$script_dir/omarchy-menu.jsonc"
dst="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"

if [[ ! -f "$src" ]]; then
    echo "No omarchy-menu.jsonc snapshot found."
    exit 0
fi

mkdir -p "$(dirname "$dst")" && cp "$src" "$dst" || {
    echo "FAILED: restoring menu" >&2
    exit 1
}
echo "Menu restored."
