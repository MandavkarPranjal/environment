#!/usr/bin/env bash

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"

if [ -z "$1" ]; then
    echo "Usage: $0 <apt|pacman|yay|flatpak|curl|omarchy> [--dry] [skip-filter1] [skip-filter2] ..."
    exit 1
fi

pkg_manager="$1"
scripts_dir="$script_dir/runs/$pkg_manager"

if [ ! -d "$scripts_dir" ]; then
    echo "Error: Directory '$scripts_dir' does not exist."
    exit 1
fi

dry_run="0"
skip_filters=()

shift
while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry)
            dry_run="1"
            ;;
        *)
            skip_filters+=("$1")
            ;;
    esac
    shift
done

log() {
    if [[ $dry_run == "1" ]]; then
        echo "[DRY_RUN]: $1"
    else
        echo "$1"
    fi
}

failures=0

log "Running scripts in '$pkg_manager'... (Skipping: ${skip_filters[*]:-None})"

for script in "$scripts_dir"/*; do
    for filter in "${skip_filters[@]}"; do
        if [[ "$script" == *"$filter"* ]]; then
            log "Skipping: $script (matches filter: $filter)"
            continue 2
        fi
    done

    if [[ -f "$script" && -x "$script" ]]; then
        log "Executing: $script"
        if [[ $dry_run == "0" ]]; then
            if ! "$script"; then
                echo "FAILED: $script" >&2
                failures=$((failures + 1))
            fi
        fi
    fi
done

if [[ $failures -gt 0 ]]; then
    echo "$failures script(s) failed." >&2
    exit 1
fi
