            {
              "file": "home/.config/hypr/bindings.conf",
              "patch": "Index: home/.config/hypr/bindings.conf\n===================================================================\n--- home/.config/hypr/bindings.conf\t\n+++ home/.config/hypr/bindings.conf\t\n@@ -1,38 +1,38 @@\n # Application bindings (swapped from SUPER to ALT)\n bindd = ALT, RETURN, Terminal, exec, uwsm-app -- xdg-terminal-exec --dir=\"$(omarchy-cmd-terminal-cwd)\"\n-bindd = SUPER ALT, RETURN, Tmux, exec, uwsm-app -- xdg-terminal-exec --dir=\"$(omarchy-cmd-terminal-cwd)\" bash -c \"tmux attach || tmux new -s Work\"\n+bindd = SUPER ALT, RETURN, Tmux, exec, uwsm-app -- xdg-terminal-exec --dir=\"$(omarchy-cmd-terminal-cwd)\" bash -c \"exec tmux new-session -A -s Work\"\n bindd = ALT SHIFT, RETURN, Browser, exec, omarchy-launch-browser\n bindd = ALT SHIFT, F, File manager, exec, uwsm-app -- nautilus --new-window\n bindd = SUPER ALT SHIFT, F, File manager (cwd), exec, uwsm-app -- nautilus --new-window \"$(omarchy-cmd-terminal-cwd)\"\n bindd = ALT SHIFT, B, Browser, exec, omarchy-launch-browser\n bindd = SUPER SHIFT ALT, B, Browser (private), exec, omarchy-launch-browser --private\n \n # OCR (was SUPER CTRL + PRINT in defaults, now ALT SHIFT + O as you requested)\n unbind = ALT CTRL, PRINT\n bindd = ALT SHIFT, O, Extract text (OCR) from screenshot, exec, omarchy-capture-text-extraction\n \n # Hold SUPER + scroll to zoom (1.5x / 0.67x steps, clamped to 1-30)\n bind = SUPER, mouse_down, exec, hyprctl keyword cursor:zoom_factor $(awk \"BEGIN {z=$(hyprctl getoption cursor:zoom_factor | awk '/float/ {print $2}') * 1.5; print (z > 30 ? 30 : z)}\")\n \n bind = SUPER, mouse_up, exec, hyprctl keyword cursor:zoom_factor $(awk \"BEGIN {z=$(hyprctl getoption cursor:zoom_factor | awk '/float/ {print $2}') * 0.67; print (z < 1 ? 1 : z)}\")\n \n # Reset\n bind = SUPER SHIFT, mouse_down, exec, hyprctl keyword cursor:zoom_factor 1\n \n # wayscriber\n bind = SUPER, D, exec, wayscriber --daemon-toggle\n \n # Add extra bindings\n # bind = ALT SHIFT, R, exec, alacritty -e ssh your-server\n \n # Overwrite existing bindings, like putting Omarchy Menu on Alt + Space\n # unbind = ALT, SPACE\n # bindd = ALT, SPACE, Omarchy menu, exec, omarchy-menu\n \n # unbind = ALT, SPACE\n bindd = SUPER, SPACE, Launch apps, exec, launch-app\n \n # Logitech MX Keys\n # bind = SUPER SHIFT, S, exec, omarchy-capture-screenshot      # Print Screen Button\n # bind = SUPER, H, exec, voxtype record toggle                 # Dictation Button\n # bind = SUPER, PERIOD, exec, omarchy-launch-walker -m symbols # Emoji Button\n",
              "additions": 1,
