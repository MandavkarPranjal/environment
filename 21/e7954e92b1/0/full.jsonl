th ./sessionizer-setup. Each root\n+# contributes distinct candidates, so all are kept; missing ones are\n+# skipped and exact duplicates are removed with sort -u.\n+project_roots=(\n+    \"$HOME/projects\"\n+    \"$HOME\"\n+    \"$HOME/work\"\n+    \"$HOME/dev\"\n+    \"$HOME/dev/environment\"\n+    \"$HOME/personal\"\n+    \"$HOME/personal/yt\"\n+    \"$HOME/personal/templates\"\n+    \"$HOME/100xdev-WebDev\"\n+    \"$HOME/sandbox\"\n+)\n+\n+pick_project() {\n+    local existing=()\n+    local root\n+    for root in \"${project_roots[@]}\"; do\n+        [[ -d \"$root\" ]] && existing+=(\"$root\")\n+    done\n+    [[ ${#existing[@]} -gt 0 ]] || return 0\n+\n+    if command -v fd >/dev/null 2>&1; then\n+        fd --max-depth 1 --type d --hidden --exclude .git . \"${existing[@]}\" 2>/dev/null | sort -u\n+    else\n+        find \"${existing[@]}\" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort -u\n     fi\n }\n \n if [[ $# -eq 1 ]]; then\n-    selected=$1\n+    selected=\"$1\"\n else\n-    selected=$(find ~/projects ~/ ~/work ~/dev ~/dev/environment ~/personal ~/personal/yt ~/personal/templates/ ~/100xdev-WebDev ~/sandbox -mindepth 1 -maxdepth 1 -type d | fzf)\n+    selected=\"$(pick_project | fzf || true)\"\n fi\n \n-if [[ -z $selected ]]; then\n-    exit 0\n-fi\n+[[ -n \"${selected:-}\" ]] || exit 0\n \n-selected_name=$(basename \"$selected\" | tr . _)\n-tmux_running=$(pgrep tmux)\n+# Deterministic session name. Dots and colons break tmux target parsing\n",
