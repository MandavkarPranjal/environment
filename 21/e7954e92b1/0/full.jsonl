            "output": "<path>/home/himmel/dev/environment/home/.config/hypr/hyprland.lua</path>\n<type>file</type>\n<content>\n1: -- Learn how to configure Hyprland: https://wiki.hypr.land/Configuring/Start/\n2: \n3: -- Omarchy's bootstrap keeps path setup out of this user config.\n4: dofile((os.getenv(\"OMARCHY_PATH\") or \"/usr/share/omarchy\") .. \"/default/hypr/bootstrap.lua\")\n5: \n6: -- Swap the main modifier from SUPER to ALT for all Omarchy defaults.\n7: -- Every default binding that uses SUPER (and not ALT) is rebound with ALT,\n8: -- restoring the pre-quattro layout where the physical Alt key is the main\n9: -- modifier. Bindings that already combine SUPER + ALT are left alone.\n10: -- The wrapper is installed only while the Omarchy defaults load; personal\n11: -- bindings in hypr/bindings.lua are free to use SUPER again.\n12: local real_hl_bind = hl.bind\n13: hl.bind = function(keys, dispatcher, options)\n14:   if type(keys) == \"string\" and not keys:find(\"ALT\", 1, true) and keys:find(\"SUPER\", 1, true) then\n15:     keys = keys:gsub(\"SUPER\", \"ALT\")\n16:   end\n17:   return real_hl_bind(keys, dispatcher, options)\n18: end\n19: \n20: -- Load Omarchy defaults.\n21: require(\"default.hypr.omarchy\")\n22: \n23: -- Restore the unmodified binding helper for the personal configs below.\n24: hl.bind = real_hl_bind\n25: \n26: -- Put your personal overrides in these files. They're loaded after Omarchy's\n27: -- defaults so package updates can improve the defaults without rewriting your\n28: -- ~/.config/hypr files.\n29: require(\"hypr.monitors\")\n30: require(\"hypr.input\")\n31: require(\"hypr.bindings\")\n32: require(\"hypr.looknfeel\")\n33: require(\"hypr.autostart\")\n34: \n35: -- Toggle config flags dynamically.\n36: require(\"default.hypr.toggles\")\n37: \n38: -- Add any other personal Hyprland configuration below.\n39: -- o.window(\"qemu\", { workspace = \"5\" })\n40: \n41: -- resolve-full-opacity (added by Omarchy_resolve_v2.sh): Omarchy's default\n42: -- window translucency is wrong for colour-critical work; keep DaVinci\n43: -- Resolve fully opaque. Loaded after Omarchy defaults, so this rule wins.\n44: o.window(\".*[Rr]esolve.*\", { opacity = \"1 1\" })\n45: \n46: -- Open DaVinci Resolve's main window over the Omarchy bar instead of under it.\n47: require(\"hypr.davinci-resolve\")\n\n(End of file - total 47 lines)\n</content>",
