              "content": "#!/usr/bin/env bash\nset -euo pipefail\n\n# Pick a project with fzf, create a tmux session for it if needed\n# (windows: nvim / shell / opencode), then attach or switch to it.\n#\n# Works from inside tmux, from inside a tmux display-popup (where TMUX is\n# set but TMUX_PANE is not), and from a plain shell with no tmux server.\n\nswitch_to() {\n    if [[ -z \"${TMUX:-}\" ]]; then\n        exec tmux attach-session -t \"$1\"\n    else\n        tmux switch-client -t \"$1\"\n    fi\n}\n\nhas_session() {\n    tmux has-session -t \"$1\" 2>/dev/null\n}\n\n# Run a project-specific (or $HOME fallback) .tmux-sessionizer in the\n# session's shell window. It is sourced as shell, so it can use tmux\n# commands or plain setup steps; it never gets typed into the nvim pane.\nhydrate() {\n    local session_name=\"$1\"\n    local project_path=\"$2\"\n    local hook=\"\"\n\n    if [[ -f \"$project_path/.tmux-sessionizer\" ]]; then\n        hook=\"$project_path/.tmux-sessionizer\"\n    elif [[ -f \"$HOME/.tmux-sessionizer\" ]]; then\n        hook=\"$HOME/.tmux-sessionizer\"\n    else\n        return 0\n    fi\n\n    tmux send-keys -t \"$session_name:shell\" \"source $(printf '%q' \"$hook\")\" Enter\n}\n\n# Depth-1 project roots. Kept in sync with ./sessionizer-setup. Each root\n# contributes distinct candidates, so all are kept; missing ones are\n# skipped and exact duplicates are removed with sort -u.\nproject_roots=(\n    \"$HOME/projects\"\n    \"$HOME\"\n    \"$HOME/work\"\n    \"$HOME/dev\"\n    \"$HOME/dev/environment\"\n    \"$HOME/personal\"\n    \"$HOME/personal/yt\"\n    \"$HOME/personal/templates\"\n    \"$HOME/100xdev-WebDev\"\n    \"$HOME/sandbox\"\n)\n\npick_project() {\n    local existing=()\n    local root\n    for root in \"${project_roots[@]}\"; do\n        [[ -d \"$root\" ]] && existing+=(\"$root\")\n    done\n    [[ ${#existing[@]} -gt 0 ]] || return 0\n\n    if command -v fd >/dev/null 2>&1; then\n        fd --max-depth 1 --type d --hidden --exclude .git . \"${existing[@]}\" 2>/dev/null | sort -u\n    else\n        find \"${existing[@]}\" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort -u\n    fi\n}\n\nif [[ $# -eq 1 ]]; then\n    selected=\"$1\"\nelse\n    selected=\"$(pick_project | fzf || true)\"\nfi\n\n[[ -n \"${selected:-}\" ]] || exit 0\n\n# Deterministic session name. Dots and colons break tmux target parsing\n# (session:window), so both become underscores. Everything is quoted, so\n# spaces in paths are safe.\nselected_name=\"$(basename \"$selected\" | tr .:__)\"\n[[ -n \"$selected_name\" ]] || exit 0\n\n# Atomic-ish creation: only the creator builds windows. A concurrent\n# invocation that loses the race falls through to switch/attach.\nif ! has_session \"$selected_name\"; then\n    if tmux new-session -d -s \"$selected_name\" -n nvim -c \"$selected\" 'nvim'; then\n        tmux new-window -d -t \"$selected_name\" -n shell -c \"$selected\"\n        tmux new-window -d -t \"$selected_name\" -n opencode -c \"$selected\" 'opencode .'\n        hydrate \"$selected_name\" \"$selected\"\n    else\n        has_session \"$selected_name\" || exit 1\n    fi\nfi\n\nswitch_to \"$selected_name\"\n",
              "filePath": "/home/himmel/dev/environment/home/scripts/tmux-sessionizer"
