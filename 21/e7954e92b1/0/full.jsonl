                "text": "#!/usr/bin/env bash\n\n# Inside a tmux popup TMUX is set but TMUX_PANE is not. There, display-message\n# resolves to the active pane behind the popup (wrong cwd), and fzf --height\n# conflicts with the popup's screen handling (blank/frozen popup).\nin_tmux_popup() {\n    [[ -n \"${TMUX:-}\" && -z \"${TMUX_PANE:-}\" ]]\n}\n\nif [[ -n \"${TMUX:-}\" ]] && ! in_tmux_popup; then\n    repo_dir=$(tmux display-message -p -F '#{pane_current_path}')\n    cd \"$repo_dir\" || exit 1\nfi\n\nif in_tmux_popup; then\n    fz() { fzf --prompt=\"$1\" --reverse; }\nelse\n    fz() { fzf --prompt=\"$1\" --height=40% --reverse; }\nfi\n\nremotes=$(git remote -v | grep '(fetch)' | awk '{print $1 \" -> \" $2}')\n\nif [[ -z \"$remotes\" ]]; then\n    echo \"No git remotes found\"\n    exit 1\nfi\n\nremote_count=$(echo \"$remotes\" | wc -l)\n\nif [[ $remote_count -eq 1 ]]; then\n    selected=\"$remotes\"\nelse\n    selected=$(echo \"$remotes\" | fz \"Select remote: \")\n    # Exit if nothing was selected\n    if [[ -z \"$selected\" ]]; then\n        exit 0\n    fi\nfi\n\nremote_url=$(echo \"$selected\" | awk '{print $3}')\n\n# Turn common Git remote formats into an owner/repository path. This lets the\n# same local repository be opened in any of the supported web frontends.\nif [[ \"$remote_url\" == git@*:* ]]; then\n    repo_path=\"${remote_url#*:}\"\nelse\n    repo_path=\"${remote_url#*://}\"\n    repo_path=\"${repo_path#*/}\"\nfi\nrepo_path=\"${repo_path%.git}\"\nrepo_path=\"$(printf '%s' \"$repo_path\" | tr '[:upper:]' '[:lower:]')\"\n\nif [[ -z \"$repo_path\" || \"$repo_path\" == \"$remote_url\" && \"$remote_url\" != git@*:* ]]; then\n    echo \"Could not determine repository path from remote: $remote_url\"\n    exit 1\nfi\n\ndestination=$(printf '%s\\n' \\\n    \"GitHub\" \\\n    \"Better Hub\" \\\n    \"OpenGit\" \\\n    \"Codeberg\" \\\n    \"Gitea\" \\\n    \"Entire\" \\\n    \"Trylle\" \\\n    \"GitCafe\" \\\n    \"GitLab\" |\n    fz \"Open in: \")\n\nif [[ -z \"$destination\" ]]; then\n    exit 0\nfi\n\ncase \"$destination\" in\n    \"GitHub\")\n        url=\"https://github.com/$repo_path\"\n        ;;\n    \"Better Hub\")\n        url=\"https://beta.better-hub.com/$repo_path\"\n        ;;\n    \"OpenGit\")\n        url=\"https://open-git.com/$repo_path\"\n        ;;\n    \"Codeberg\")\n        url=\"https://codeberg.org/$repo_path\"\n        ;;\n    \"Gitea\")\n        url=\"https://gitea.com/$repo_path\"\n        ;;\n    \"Entire\")\n        url=\"https://entire.io/gh/$repo_path\"\n        ;;\n    \"Trylle\")\n        url=\"https://trylle.com/$repo_path\"\n        ;;\n    \"GitCafe\")\n        url=\"https://git.cafe/$repo_path\"\n        ;;\n    \"GitLab\")\n        url=\"https://gitlab.com/$repo_path\"\n        ;;\nesac\n\n# fzf/tmux can preserve an accidental space in a copied remote URL. A web URL\n# must not contain whitespace, so normalize it before handing it to the opener.\nurl=\"${url//[[:space:]]/}\"\nprintf 'Opening: %s\\n' \"$url\"\n\n# Launch synchronously where possible: when run from a tmux popup, the popup\n# (and its process group) is torn down as soon as this script exits, which\n# kills a backgrounded launcher before it can hand off. systemd-run returns\n# immediately after registering the unit, and setsid --fork detaches the\n# fallback openers into their own session so they survive popup teardown.\nbrowser_desktop=$(env -u BROWSER xdg-settings get default-web-browser 2>/dev/null)\nif [[ \"$browser_desktop\" == \"app.zen_browser.zen.desktop\" ]] && command -v uwsm-app >/dev/null 2>&1; then\n    systemd-run --user --quiet --collect \\\n        --unit=\"open-repo-browser-$(date +%s%N)\" \\\n        uwsm-app -- flatpak run app.zen_browser.zen \"$url\" \\\n        >/dev/null 2>&1 </dev/null\nelif command -v omarchy-launch-browser >/dev/null 2>&1; then\n    setsid --fork omarchy-launch-browser \"$url\" >/dev/null 2>&1 </dev/null\nelif command -v gio >/dev/null 2>&1; then\n    setsid --fork gio open \"$url\" >/dev/null 2>&1 </dev/null\nelse\n    setsid --fork xdg-open \"$url\" >/dev/null 2>&1 </dev/null\nfi",
