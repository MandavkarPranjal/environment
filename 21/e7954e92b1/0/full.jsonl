              "preview": "#!/usr/bin/env bash\n\n# Inside a tmux popup TMUX is set but TMUX_PANE is not. There, display-message\n# resolves to the active pane behind the popup (wrong cwd), and fzf --height\n# conflicts with the popup's screen handling (blank/frozen popup).\nin_tmux_popup() {\n    [[ -n \"${TMUX:-}\" && -z \"${TMUX_PANE:-}\" ]]\n}\n\nif [[ -n \"${TMUX:-}\" ]] && ! in_tmux_popup; then\n    repo_dir=$(tmux display-message -p -F '#{pane_current_path}')\n    cd \"$repo_dir\" || exit 1\nfi\n\nif in_tmux_popup; then\n    fz() { fzf --prompt=\"$1\" --reverse; }\nelse\n    fz() { fzf --prompt=\"$1\" --height=40% --reverse; }\nfi\n",
