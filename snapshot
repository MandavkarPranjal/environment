#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" &> /dev/null && pwd)"
home_dir="$HOME"
home_re="$(printf '%s' "$home_dir" | sed 's/[][\.*^$|&\/]/\\&/g')"
runs_dir="$script_dir/runs"

tokenize() {
    sed -e "s|$home_re/|__HOME__/|g" -e "s|$home_re\$|__HOME__|g"
}

mkdir -p "$runs_dir/pacman" "$runs_dir/yay" "$runs_dir/flatpak" "$runs_dir/js" "$runs_dir/omarchy"

if command -v pacman > /dev/null 2>&1; then
    if pacman -Qqen | { grep -vE '^(linux(-(lts|zen|hardened|rt|omarchy))?(-headers)?|nvidia[^[:space:]]*|lib32-nvidia[^[:space:]]*|vulkan-(intel|radeon|nouveau)|lib32-vulkan-(intel|radeon)|mesa)$' || [[ $? -eq 1 ]]; } | sort > "$runs_dir/pacman/packages.list"; then
        echo "pacman: $(wc -l < "$runs_dir/pacman/packages.list") packages -> runs/pacman/packages.list"
    else
        echo "snapshot: warning: failed to list native packages" >&2
    fi
    if pacman -Qqem | sort > "$runs_dir/yay/aur.list"; then
        echo "aur: $(wc -l < "$runs_dir/yay/aur.list") packages -> runs/yay/aur.list"
    else
        echo "snapshot: warning: failed to list AUR packages" >&2
    fi
fi

if command -v flatpak > /dev/null 2>&1; then
    if flatpak list --app --columns=application,origin | sort -u > "$runs_dir/flatpak/apps.list"; then
        echo "flatpak: $(wc -l < "$runs_dir/flatpak/apps.list") apps -> runs/flatpak/apps.list"
    else
        echo "snapshot: warning: failed to list flatpak apps" >&2
    fi
fi

js_list="$runs_dir/js/globals.list"
{
    cat <<'header'
# Globally installed JS packages (bun, npm, pnpm).
#
# Format: manager | package | version
#   - version is the one currently installed; "*" means "whatever the manager
#     installs today", so the package is reinstalled on every ./run js.
#
# Generated by ./snapshot (see runs/js/collect.sh), installed by
# runs/js/install. Pin a version to make the install reproducible, drop a line
# to stop tracking that package, add one by hand to track something the
# snapshot did not catch.
header
} > "$js_list"
if [[ -f "$script_dir/runs/js/collect.sh" ]]; then
    # shellcheck source=runs/js/collect.sh
    source "$script_dir/runs/js/collect.sh"
    js_globals="$(js_collect_globals "$home_dir" | sort -u)"
    if [[ -n "$js_globals" ]]; then
        printf '\n%s\n' "$js_globals" >> "$js_list"
        echo "js: $(printf '%s\n' "$js_globals" | wc -l) global package(s) -> runs/js/globals.list"
    else
        echo "js: no global bun/npm/pnpm packages found"
    fi
else
    echo "snapshot: warning: runs/js/collect.sh missing, globals.list left empty" >&2
fi

omarchy_dir="$home_dir/.config/omarchy"

if [[ -d "$omarchy_dir" ]]; then
    if [[ -f "$omarchy_dir/shell.json" ]]; then
        tokenize < "$omarchy_dir/shell.json" > "$runs_dir/omarchy/shell.json"
        echo "omarchy: shell.json -> runs/omarchy/shell.json"
    fi

    if [[ -f "$omarchy_dir/extensions/omarchy-menu.jsonc" ]]; then
        cp "$omarchy_dir/extensions/omarchy-menu.jsonc" "$runs_dir/omarchy/omarchy-menu.jsonc"
        echo "omarchy: omarchy-menu.jsonc -> runs/omarchy/omarchy-menu.jsonc"
    fi

    if [[ -d "$omarchy_dir/plugins" ]]; then
        : > "$runs_dir/omarchy/plugins.list"
        for plugin in "$omarchy_dir/plugins"/*/; do
            [[ -d "$plugin" ]] || continue
            id="$(basename "$plugin")"
            if ! url="$(git -C "$plugin" remote get-url origin 2>/dev/null)"; then
                echo "omarchy: warning: no git remote for plugin '$id', skipping" >&2
                continue
            fi
            printf '%s\t%s\n' "$id" "$url" >> "$runs_dir/omarchy/plugins.list"
        done
        sort -o "$runs_dir/omarchy/plugins.list" "$runs_dir/omarchy/plugins.list"
        echo "omarchy: $(wc -l < "$runs_dir/omarchy/plugins.list") plugins -> runs/omarchy/plugins.list"
    fi

    if command -v omarchy > /dev/null 2>&1; then
        if omarchy theme current > "$runs_dir/omarchy/theme.name" 2>/dev/null && [[ -s "$runs_dir/omarchy/theme.name" ]]; then
            echo "omarchy: theme '$(< "$runs_dir/omarchy/theme.name")' -> runs/omarchy/theme.name"
        else
            rm -f "$runs_dir/omarchy/theme.name"
            echo "snapshot: warning: could not read current theme" >&2
        fi
    fi

    if [[ -f "$home_dir/.local/state/omarchy/current/background" ]]; then
        tokenize < <(readlink -f "$home_dir/.local/state/omarchy/current/background") > "$runs_dir/omarchy/background.path"
        echo "omarchy: background -> runs/omarchy/background.path"
    fi

    if [[ -d "$omarchy_dir/hooks" ]]; then
        if command -v rsync > /dev/null 2>&1; then
            rsync -a --delete --exclude='*.sample' "$omarchy_dir/hooks/" "$runs_dir/omarchy/hooks/"
        else
            mkdir -p "$runs_dir/omarchy/hooks"
            cp -a "$omarchy_dir/hooks/." "$runs_dir/omarchy/hooks/"
            find "$runs_dir/omarchy/hooks" -name '*.sample' -delete
        fi
        echo "omarchy: hooks -> runs/omarchy/hooks/"
    fi

    if [[ -d "$omarchy_dir/themed" ]]; then
        if command -v rsync > /dev/null 2>&1; then
            rsync -a --delete --exclude='*.sample' --exclude='*.bak' "$omarchy_dir/themed/" "$runs_dir/omarchy/themed/"
        else
            mkdir -p "$runs_dir/omarchy/themed"
            cp -a "$omarchy_dir/themed/." "$runs_dir/omarchy/themed/"
            find "$runs_dir/omarchy/themed" \( -name '*.sample' -o -name '*.bak' \) -delete
        fi
        echo "omarchy: themed templates -> runs/omarchy/themed/"
    fi
fi

echo "Snapshot complete."
