          "synthetic": true,
          "text": "<path>/home/himmel/dev/environment/home/.config/hypr/bindings.conf</path>\n<type>file</type>\n<content>\n1: # Application bindings (swapped from SUPER to ALT)\n2: bindd = ALT, RETURN, Terminal, exec, uwsm-app -- xdg-terminal-exec --dir=\"$(omarchy-cmd-terminal-cwd)\"\n3: bindd = SUPER ALT, RETURN, Tmux, exec, uwsm-app -- xdg-terminal-exec --dir=\"$(omarchy-cmd-terminal-cwd)\" bash -c \"tmux attach || tmux new -s Work\"\n4: bindd = ALT SHIFT, RETURN, Browser, exec, omarchy-launch-browser\n5: bindd = ALT SHIFT, F, File manager, exec, uwsm-app -- nautilus --new-window\n6: bindd = SUPER ALT SHIFT, F, File manager (cwd), exec, uwsm-app -- nautilus --new-window \"$(omarchy-cmd-terminal-cwd)\"\n7: bindd = ALT SHIFT, B, Browser, exec, omarchy-launch-browser\n8: bindd = SUPER SHIFT ALT, B, Browser (private), exec, omarchy-launch-browser --private\n9: \n10: # OCR (was SUPER CTRL + PRINT in defaults, now ALT SHIFT + O as you requested)\n11: unbind = ALT CTRL, PRINT\n12: bindd = ALT SHIFT, O, Extract text (OCR) from screenshot, exec, omarchy-capture-text-extraction\n13: \n14: # Hold SUPER + scroll to zoom (1.5x / 0.67x steps, clamped to 1-30)\n15: bind = SUPER, mouse_down, exec, hyprctl keyword cursor:zoom_factor $(awk \"BEGIN {z=$(hyprctl getoption cursor:zoom_factor | awk '/float/ {print $2}') * 1.5; print (z > 30 ? 30 : z)}\")\n16: \n17: bind = SUPER, mouse_up, exec, hyprctl keyword cursor:zoom_factor $(awk \"BEGIN {z=$(hyprctl getoption cursor:zoom_factor | awk '/float/ {print $2}') * 0.67; print (z < 1 ? 1 : z)}\")\n18: \n19: # Reset\n20: bind = SUPER SHIFT, mouse_down, exec, hyprctl keyword cursor:zoom_factor 1\n21: \n22: # wayscriber\n23: bind = SUPER, D, exec, wayscriber --daemon-toggle\n24: \n25: # Add extra bindings\n26: # bind = ALT SHIFT, R, exec, alacritty -e ssh your-server\n27: \n28: # Overwrite existing bindings, like putting Omarchy Menu on Alt + Space\n29: # unbind = ALT, SPACE\n30: # bindd = ALT, SPACE, Omarchy menu, exec, omarchy-menu\n31: