else\n66:       return \"omarchy-launch-tui \" .. shell_quote(value.tui)\n67:     end\n68:   end\n69: \n70:   return value\n71: end\n72: \n73: function o.preinstalled_bindings_enabled()\n74:   if _G.omarchy_preinstalled_bindings ~= nil then\n75:     return _G.omarchy_preinstalled_bindings == true\n76:   end\n77: \n78:   return not file_exists((os.getenv(\"HOME\") or \"\") .. \"/.local/state/omarchy/preinstalls-removed\")\n79: end\n80: \n81: function o.bind(keys, description, dispatcher, options)\n82:   local opts = options or {}\n83: \n84:   if description then\n85:     opts.description = description\n86:   end\n87: \n88:   dispatcher = command_from(dispatcher, description)\n89: \n90:   if type(dispatcher) == \"string\" then\n91:     dispatcher = hl.dsp.exec_cmd(dispatcher)\n92:   end\n93: \n94:   hl.bind(keys, dispatcher, opts)\n95: end\n96: \n97: function o.launch(command)\n98:   return \"uwsm-app -- \" .. command\n99: end\n100: \n101: function o.exec_on_start(command)\n102:   hl.on(\"hyprland.start\", function()\n103:     hl.exec_cmd(command)\n104:   end)\n105: end\n106: \n107: function o.launch_on_start(command)\n108:   o.exec_on_start(o.launch(command))\n109: end\n110: \n111: function o.launch_webapp(url)\n112:   return \"omarchy-launch-webapp \" .. shell_quote(url)\n113: end\n114: \n115: function o.launch_webapp_sole(name, url)\n116:   return \"omarchy-launch-or-focus-webapp \" .. shell_quote(name) .. \" \" .. shell_quote(url)\n117: end\n118: \n119: function o.launch_sole(match, command)\n120:   return \"omarchy-launch-or-focus \" .. shell_quote(match) .. \" \" .. shell_quote(o.launch(command))\n121: end\n122: \n123: function o.bind_toggle(keys, description, toggle, options)\n124:   o.bind(keys, description, \"omarchy-toggle-\" .. toggle, options)\n125: end\n126: \n127: function o.notify(message)\n128:   return \"notify-send -u low \" .. shell_quote(message)\n129: end\n130: \n131: function o.window(match, rules)\n132:   rules.match = rules.match or {}\n133: \n